{
  "name": "materialize-css",
  "version": "2.0.0",
  "description": "Modern Material Design CSS Framework - v2 with TypeScript, Vite, and no jQuery",
  "author": "Alvin Wang, Alan Chang",
  "maintainers": [
    {
      "name": "Materialize Contributors"
    }
  ],
  "homepage": "http://materializecss.com/",
  "repository": {
    "type": "git",
    "url": "git://github.com/Dogfalo/materialize.git"
  },
  "bugs": {
    "url": "https://github.com/Dogfalo/materialize/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/js/materialize.js",
  "module": "dist/js/materialize.es.js",
  "types": "dist/js/materialize.d.ts",
  "style": "dist/css/materialize.css",
  "sass": "sass/materialize.scss",
  "exports": {
    ".": {
      "import": "./dist/js/materialize.es.js",
      "require": "./dist/js/materialize.js"
    },
    "./css": "./dist/css/materialize.css",
    "./scss": "./sass/materialize.scss"
  },
  "files": [
    "dist/",
    "sass/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "lint": "biome check src/",
    "lint:check": "biome check src/",
    "format": "biome format src/ --write",
    "format:check": "biome format src/",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "a11y": "pa11y",
    "a11y:audit": "axe",
    "lighthouse": "lighthouse http://localhost:5173 --chrome-flags=\"--headless\" --output-path=./reports/lighthouse.json",
    "pre-commit": "lint-staged",
    "clean": "rm -rf dist/ node_modules/ .pnpm-store/",
    "postinstall": "husky install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^25.9.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/ui": "^4.1.8",
    "autoprefixer": "^10.5.0",
    "axe-core": "^4.12.0",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "pa11y": "^9.1.1",
    "postcss": "^8.5.15",
    "sass": "^1.100.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "biome check --write"
    ],
    "src/**/*.scss": [
      "biome format --write"
    ],
    "*.{json,md}": [
      "biome format --write"
    ]
  },
  "eslintConfig": {
    "root": true,
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaVersion": 2022,
      "sourceType": "module"
    },
    "env": {
      "browser": true,
      "es2022": true,
      "node": true
    },
    "plugins": [
      "@typescript-eslint",
      "prettier"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "prettier"
    ],
    "rules": {
      "no-console": "warn",
      "no-debugger": "warn",
      "@typescript-eslint/no-explicit-any": "error",
      "prettier/prettier": "error"
    }
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100,
    "arrowParens": "always"
  },
  "keywords": [
    "material-design",
    "css",
    "framework",
    "responsive",
    "frontend",
    "scss",
    "typescript",
    "vite"
  ]
}
