# NPMRC - Configuración Global de pnpm para Materialize v2
# Seguridad: Versiones exactas, sin rangos de versión

# ====================================================================
# SEGURIDAD - Versiones Exactas (Sin ^ o ~)
# ====================================================================
overrides.@aashutoshrathi/word-wrap=1.2.6

# No instalar versiones con rangos
save-prefix=
# Equivalente a: npm config set save-prefix=""

# Instalar versiones exactas por defecto
save-exact=true

# ====================================================================
# PNPM ESPECÍFICOS
# ====================================================================

# Usar estrategia menos estricta de dependencias para permitir resolución automática
strict-peer-dependencies=false

# No deduplicar si hay conflictos - usar hoisting para mejor compatibilidad
shamefully-hoist=true

# Usar pnpm workspace
use-workspace-root=true

# ====================================================================
# SEGURIDAD ADICIONAL
# ====================================================================

# Auditar antes de instalar
audit-level=moderate

# Verificar integridad
verify-store-integrity=true

# ====================================================================
# PERFORMANCE
# ====================================================================

# Usar network paralelo
network-timeout=60000

# Compilaciones paralelas
fetch-retries=3
fetch-retry-factor=2

# ====================================================================
# LOGS Y DEBUG
# ====================================================================

# Verbosidad
loglevel=warn

# Mostrar detalles de instalación
# uncomment para debug:
# loglevel=verbose
